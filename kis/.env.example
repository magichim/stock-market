# demo: 모의투자 | real: 실전투자. 모의투자는 지수·환율·해외 시세 등 일부 조회 API를 지원하지 않는다
KIS_ENV=demo
# 주문·정정·취소 API 허용. 이 서비스에는 로그인이 없으므로 꼭 필요할 때만 true
KIS_ALLOW_ORDER=false

# KIS Developers에서 발급받은 값 (실전)
KIS_APP_KEY=
KIS_APP_SECRET=
# 모의투자
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=

KIS_HTS_ID=
# 계좌번호 앞 8자리
KIS_ACCT_STOCK=
KIS_ACCT_FUTURE=
KIS_PAPER_ACCT_STOCK=
KIS_PAPER_ACCT_FUTURE=
# 계좌번호 뒤 2자리 (01: 종합계좌)
KIS_PROD=01
