# agisaja.com(predict-market) 백엔드와 같은 값. 다르면 모든 요청이 비로그인으로 처리된다 (필수)
JWT_SECRET=
# access 쿠키 이름. 운영은 기본값(__Secure-at). 로컬에서 predict-market이 COOKIE_SECURE=false면 at
ACCESS_COOKIE=__Secure-at
# predict-market 백엔드 — 사용자 프로필을 내부 API로 조회한다. 운영은 기본값(https://agisaja.com), 로컬은 http://localhost:8000
PREDICT_API_URL=https://agisaja.com
# 내부 API 토큰 — predict-market INTERNAL_API_TOKEN과 같은 값 (필수)
INTERNAL_API_TOKEN=
# 이 서비스 전용 DB — 시작 시 테이블을 만든다 (DB_DESIGN.md)
DATABASE_URL=postgresql+asyncpg://dev@localhost:5432/stock_market
REDIS_URL=redis://localhost:6379/0
# 가격 공급자 (현재 mock만 — 실 거래소 API 연동 전 랜덤 워크)
PRICE_PROVIDER=mock
PRICE_INTERVAL_SECONDS=60
# 로컬에서 장 시간(평일 09:00–15:30 KST) 밖에도 수집·거래하려면 true. 운영은 false
IGNORE_MARKET_HOURS=false
INITIAL_CASH=10000000
